# name: test/sql/alter/struct_evolution_list_filter_71.test
# description: #71 - filter on a renamed struct field inside a list over inlined data must not drop rows
# group: [alter]

require ducklake

require parquet

statement ok
ATTACH 'ducklake:__TEST_DIR__/ducklake_struct_evo_71.db' AS ducklake (DATA_PATH '__TEST_DIR__/ducklake_struct_evo_71_files')

statement ok
CREATE TABLE ducklake.test(col1 STRUCT(i INT)[]);

statement ok
INSERT INTO ducklake.test VALUES ([{'i': 1000}]);

statement ok
ALTER TABLE ducklake.test RENAME col1.element.i TO v1;

query I
SELECT col1[1].v1 FROM ducklake.test;
----
1000

query I
SELECT col1[1].v1 FROM ducklake.test WHERE col1[1].v1 = 1000;
----
1000

query I
SELECT count(*) FROM ducklake.test WHERE col1[1].v1 IS NOT NULL;
----
1
