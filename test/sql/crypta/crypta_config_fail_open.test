# name: test/sql/crypta/crypta_config_fail_open.test
# description: CHARACTERISATION - three ways a configured crypta is silently ignored
# group: [crypta]
#
# PRIVATE-FORK ONLY. Never cherry-pick to the public upstream fork.
#
# READ THIS BEFORE READING THE ASSERTIONS.
#
# Every other file in this group asserts a REFUSAL. This one does the opposite:
# it records three configurations where the operator asked for crypta, got no
# error, and got NO ENVELOPE - so the per-file keys are written to the catalog in
# plaintext, which is precisely what the envelope exists to prevent.
#
# These are DEFECTS, reported and not fixed here. This suite tests the envelope;
# it does not change it. They are written down as executable assertions rather
# than prose for one reason: the day either is fixed, the assertion below turns
# RED and whoever fixed it is told, by name, that this file now records
# something untrue and should be replaced with the refusal.
#
# Both are fail-OPEN, which is the direction that matters. Everywhere else this
# provider fails closed.

require ducklake

require parquet

require httpfs

# Case 2 needs a REACHABLE service to make its point, so this file runs under
# run_sql_crypta_tests.sh like crypta_key_row_refusals.test does.
require-env DUCKLAKE_FAKE_CRYPTA_SOCKET

# --------------------------------------------------------------------------
# 1. An empty CRYPTA_SOCKET disables the envelope instead of being refused
#
# DuckLakeCatalog guards the whole crypta block with
# `if (!options.crypta_socket.empty())`, so CRYPTA_SOCKET '' never reaches
# CryptaClient's own "crypta socket path is empty" refusal - that refusal is
# unreachable from ATTACH entirely.
#
# The realistic way in is an unset variable: CRYPTA_SOCKET '${CRYPTA_SOCK}'
# expands to '' and the lake attaches, writes, and reads with no error at all.
# --------------------------------------------------------------------------

statement ok
ATTACH 'ducklake:__TEST_DIR__/crypta_empty_socket.db' AS emptysocket (DATA_PATH '__TEST_DIR__/crypta_empty_socket_files', ENCRYPTED, DATA_INLINING_ROW_LIMIT 0, METADATA_CATALOG 'emptysocket_meta', CRYPTA_SOCKET '', CRYPTA_LAKE_ID 'fixture')

statement ok
CREATE TABLE emptysocket.t AS SELECT i AS id FROM range(100) t(i)

query I
SELECT sum(id) FROM emptysocket.t
----
4950

# What landed in the catalog is a 44-character base64 PLAINTEXT key - the raw
# 32-byte DEK this fork mints - not a wrapped blob. Anyone who can read the
# catalog holds the key to the file.
query II
SELECT length(encryption_key), encryption_key LIKE 'RExL%' FROM emptysocket_meta.ducklake_data_file
----
44	false

statement ok
DETACH emptysocket

# --------------------------------------------------------------------------
# 2. CRYPTA_SOCKET on a lake left at the AUTOMATIC default is silently ignored
#
# The guard reads `if (options.encryption == DuckLakeEncryption::UNENCRYPTED)`,
# and the default is AUTOMATIC, not UNENCRYPTED. So the misconfiguration it
# exists to catch - crypta pointed at a lake with no per-file keys to wrap - is
# caught only when the operator writes ENCRYPTED false EXPLICITLY, and slips
# through when they simply forget ENCRYPTED.
#
# To be precise about what does and does not happen, because half of it is
# right: the provider IS still constructed and the self-test DOES still run, so
# an unreachable crypta is refused here exactly as everywhere else. What is
# missing is the other half - a fresh AUTOMATIC lake resolves to unencrypted, so
# there are no per-file keys, nothing is wrapped, and the operator who asked for
# envelope encryption gets a lake with no encryption at all and no diagnostic.
# --------------------------------------------------------------------------

statement ok
ATTACH 'ducklake:__TEST_DIR__/crypta_automatic.db' AS automatic (DATA_PATH '__TEST_DIR__/crypta_automatic_files', DATA_INLINING_ROW_LIMIT 0, METADATA_CATALOG 'automatic_meta', CRYPTA_SOCKET '${DUCKLAKE_FAKE_CRYPTA_SOCKET}', CRYPTA_LAKE_ID 'fixture')

statement ok
CREATE TABLE automatic.t AS SELECT i AS id FROM range(100) t(i)

query I
SELECT sum(id) FROM automatic.t
----
4950

# No key at all: the lake is not encrypted. The operator asked for envelope
# encryption and got neither an envelope nor encryption, and no diagnostic.
query I
SELECT count(*) FILTER (WHERE encryption_key IS NULL) = count(*) FROM automatic_meta.ducklake_data_file
----
true

statement ok
DETACH automatic

# --------------------------------------------------------------------------
# 3. CRYPTA_LAKE_ID with no CRYPTA_SOCKET is silently ignored
#
# The mirror of case 1, and the same blast radius: both come from a templated
# ATTACH string where one substitution went missing. The lake id alone reaches
# nothing - the whole crypta block hangs off `!crypta_socket.empty()` - so the
# operator who half-configured the envelope gets no envelope and no diagnostic.
#
# Note the asymmetry that makes this worth its own case: the OPPOSITE omission
# (socket without lake id) IS refused, loudly, in crypta_attach_refusals.test.
# Only this direction is silent.
# --------------------------------------------------------------------------

statement ok
ATTACH 'ducklake:__TEST_DIR__/crypta_lake_id_only.db' AS lakeidonly (DATA_PATH '__TEST_DIR__/crypta_lake_id_only_files', ENCRYPTED, DATA_INLINING_ROW_LIMIT 0, METADATA_CATALOG 'lakeidonly_meta', CRYPTA_LAKE_ID 'fixture')

statement ok
CREATE TABLE lakeidonly.t AS SELECT i AS id FROM range(100) t(i)

query I
SELECT sum(id) FROM lakeidonly.t
----
4950

query II
SELECT length(encryption_key), encryption_key LIKE 'RExL%' FROM lakeidonly_meta.ducklake_data_file
----
44	false

statement ok
DETACH lakeidonly
