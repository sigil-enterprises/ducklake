# name: test/sql/encryption/envelope_attach_refusals.test
# description: A half-configured encryption envelope, and an enveloped lake asked to inline, are refused at ATTACH
# group: [encryption]

require ducklake

require parquet

# shape (c) - a lake id with no socket is the fail-open direction: a templated
# ATTACH that lost one substitution used to silently write the per-file keys in
# plaintext. Refused before any key is minted.
statement error
ATTACH 'ducklake:{TEST_DIR}/envelope_no_socket.db' AS no_socket (DATA_PATH '{TEST_DIR}/envelope_no_socket_files', ENCRYPTION_LAKE_ID 'some-lake')
----
encryption_socket / encryption_provider must be set when encryption_lake_id is set

# An enveloped lake never inlines rows - the inlined-data path writes the row
# values as cleartext SQL literals into the metadata catalog, which the envelope
# does not protect. An explicit non-zero limit is refused rather than silently
# forced to 0. Two substrings asserted separately (distinct aliases, because a
# refused ATTACH still consumed the alias) so a wording tweak reds one line and
# names itself.
statement error
ATTACH 'ducklake:{TEST_DIR}/envelope_inline.db' AS inline_refusal (DATA_PATH '{TEST_DIR}/envelope_inline_files', ENCRYPTED, ENCRYPTION_SOCKET '/tmp/fake.sock', ENCRYPTION_LAKE_ID 'some-lake', DATA_INLINING_ROW_LIMIT 10)
----
data_inlining_row_limit

statement error
ATTACH 'ducklake:{TEST_DIR}/envelope_inline2.db' AS inline_refusal2 (DATA_PATH '{TEST_DIR}/envelope_inline2_files', ENCRYPTED, ENCRYPTION_SOCKET '/tmp/fake.sock', ENCRYPTION_LAKE_ID 'some-lake', DATA_INLINING_ROW_LIMIT 10)
----
envelope does not protect (it wraps the per-file Parquet keys only)

# Issue #120 - per-catalog provider selection. Provider options with no
# envelope turned on would be silently dropped: there is no provider to hand
# them to. Refused, like encryption_cache_ttl_seconds on its own.
statement error
ATTACH 'ducklake:{TEST_DIR}/envelope_options_only.db' AS options_only (DATA_PATH '{TEST_DIR}/envelope_options_only_files', ENCRYPTION_PROVIDER_OPTIONS MAP {'tag': 'x'})
----
encryption_provider_options was set without encryption_socket or encryption_provider

# An empty provider name is the shape an unexpanded `${VAR}` takes in a
# templated ATTACH. It must not silently fall back to the default provider.
statement error
ATTACH 'ducklake:{TEST_DIR}/envelope_empty_provider.db' AS empty_provider (DATA_PATH '{TEST_DIR}/envelope_empty_provider_files', ENCRYPTED, ENCRYPTION_PROVIDER '', ENCRYPTION_LAKE_ID 'some-lake')
----
encryption_provider was set to an empty string

# A named provider still needs a lake id - without it keys are interchangeable
# between lakes, whichever provider wraps them.
statement error
ATTACH 'ducklake:{TEST_DIR}/envelope_provider_no_lake.db' AS provider_no_lake (DATA_PATH '{TEST_DIR}/envelope_provider_no_lake_files', ENCRYPTED, ENCRYPTION_PROVIDER 'anything')
----
encryption_provider requires a non-empty encryption_lake_id

# Since issue #120 ENCRYPTION_PROVIDER alone turns the envelope on, so every
# refusal about a missing or conflicting envelope names BOTH options. A message
# that names only encryption_socket tells an operator who wrote
# ENCRYPTION_PROVIDER to add an option they do not need.
statement error
ATTACH 'ducklake:{TEST_DIR}/envelope_ttl_only.db' AS ttl_only (DATA_PATH '{TEST_DIR}/envelope_ttl_only_files', ENCRYPTION_CACHE_TTL_SECONDS 60)
----
encryption_cache_ttl_seconds was set without encryption_socket / encryption_provider

statement error
ATTACH 'ducklake:{TEST_DIR}/envelope_provider_inline.db' AS provider_inline (DATA_PATH '{TEST_DIR}/envelope_provider_inline_files', ENCRYPTED, ENCRYPTION_PROVIDER 'anything', ENCRYPTION_LAKE_ID 'some-lake', DATA_INLINING_ROW_LIMIT 10)
----
encryption_socket / encryption_provider was set together with data_inlining_row_limit

# A NULL options map is refused AS INPUT, never dereferenced: reading the
# entries of a NULL MAP raises an InternalException. Two layers can refuse it.
# Measured on DuckDB v1.5.5, the ATTACH binder rejects a NULL value for every
# option before DuckLake sees it; DuckLake's own check is the one that holds if
# a path ever hands it one. Either refusal passes - any other outcome, an
# InternalException included, reds this.
statement error
ATTACH 'ducklake:{TEST_DIR}/envelope_null_options.db' AS null_options (DATA_PATH '{TEST_DIR}/envelope_null_options_files', ENCRYPTED, ENCRYPTION_PROVIDER 'anything', ENCRYPTION_PROVIDER_OPTIONS CAST(NULL AS MAP(VARCHAR, VARCHAR)), ENCRYPTION_LAKE_ID 'some-lake')
----
<REGEX>:.*(NULL is not supported as a valid option for ATTACH option "encryption_provider_options"|encryption_provider_options may not be NULL).*
